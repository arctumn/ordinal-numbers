{
  "name": "ordinal-words",
  "version": "1.0.1",
  "description": "Ordinal numbers as text writes them (21.º, 21st) or spelled out (vigésimo primeiro, twenty-first) — pt-PT and en-US, gender and plural aware, zero dependencies",
  "keywords": [
    "ordinal",
    "ordinals",
    "ordinal-numbers",
    "number-to-words",
    "i18n",
    "l10n",
    "locale",
    "portuguese",
    "pt-PT",
    "english",
    "en-US"
  ],
  "license": "ISC",
  "author": "Pedro Lopes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arctumn/ordinal-words.git"
  },
  "bugs": {
    "url": "https://github.com/arctumn/ordinal-words/issues"
  },
  "homepage": "https://github.com/arctumn/ordinal-words#readme",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./locales/en-US": {
      "import": {
        "types": "./dist/esm/locales/en-US.d.ts",
        "default": "./dist/esm/locales/en-US.js"
      },
      "require": {
        "types": "./dist/cjs/locales/en-US.d.ts",
        "default": "./dist/cjs/locales/en-US.js"
      }
    },
    "./locales/pt-PT": {
      "import": {
        "types": "./dist/esm/locales/pt-PT.d.ts",
        "default": "./dist/esm/locales/pt-PT.js"
      },
      "require": {
        "types": "./dist/cjs/locales/pt-PT.d.ts",
        "default": "./dist/cjs/locales/pt-PT.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "locales/*": [
        "./dist/esm/locales/*.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "test:watch": "node --test --watch 'test/*.test.ts'",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.2"
  }
}
